{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.2.0",
  "packages": [
    "npm:@johansja/pi-permission-gate",
    "npm:@cortexkit/pi-magic-context"
  ],
  "defaultProvider": "aigw",
  "defaultModel": "claude-sonnet",
  "permissionGate": {
    "model": "aigw/claude-haiku",
    "blockLevel": "medium",
    "maxTokens": 32000
  },
  "autoSessionName": {
    "model": "aigw/claude-haiku"
  },
  "defaultThinkingLevel": "max",
  "retry": {
    "maxRetries": 5,
    "baseDelayMs": 10000,
    "provider": {
      "maxRetries": 5
    }
  },
  "theme": "system",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32000
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "tuiMode": "regular",
  "fullscreenScrollbar": "auto",
  "autocompleteMaxVisible": 10,
  "quietStartup": false,
  "enabledModels": [
    "aigw/claude-sonnet",
    "aigw/claude-haiku"
  ]
}